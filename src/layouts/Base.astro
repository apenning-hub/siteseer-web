---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';
import { AUDIENCE } from '../lib/audience';

interface Props {
  title?: string;
  description?: string;
}
const site = await getEntry('sites', AUDIENCE);
// A malformed site file leaves the collection silently empty rather than
// failing the build, so fail loudly here instead of shipping a blank page.
if (!site) throw new Error(`No site copy for "${AUDIENCE}": check src/content/sites/${AUDIENCE}.json`);
const { title = site.data.meta.title, description = site.data.meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- BETA ONLY. The review subdomains serve copy that will later live on
         siteseer.education, so keep them out of search until promotion.
         Remove this line and public/robots.txt then — see the launch checklist. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav cta={site.data.nav.cta} ctaShort={site.data.nav.ctaShort} />
    <main id="main">
      <slot />
    </main>
    <Footer draft={site.data.draft} />
    <script>
      import '../scripts/nav.js';
      import '../scripts/motion.js';
    </script>
  </body>
</html>
