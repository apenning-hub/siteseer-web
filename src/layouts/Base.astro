---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';
import { AUDIENCE } from '../lib/audience';

interface Props {
  title?: string;
  description?: string;
}
const site = await getEntry('sites', AUDIENCE);
// A malformed site file leaves the collection silently empty rather than
// failing the build, so fail loudly here instead of shipping a blank page.
if (!site) throw new Error(`No site copy for "${AUDIENCE}": check src/content/sites/${AUDIENCE}.json`);
const { title = site.data.meta.title, description = site.data.meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- BETA ONLY. The review subdomains serve copy that will later live on
         siteseer.education, so keep them out of search until promotion.
         Remove this line and public/robots.txt then — see the launch checklist. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 34 34'%3E%3Crect width='34' height='34' rx='9' fill='%23e6332a'/%3E%3Cpath d='M8 16.5 L17 9 L26 16.5' stroke='%23fff' stroke-width='2.4' fill='none' stroke-linejoin='round'/%3E%3Cline x1='10.5' y1='21.2' x2='23.5' y2='21.2' stroke='%23fff' stroke-width='2.4'/%3E%3Cline x1='10.5' y1='25.6' x2='23.5' y2='25.6' stroke='%23fff' stroke-width='2.4'/%3E%3C/svg%3E" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav cta={site.data.nav.cta} />
    <main id="main">
      <slot />
    </main>
    <Footer draft={site.data.draft} />
    <script>
      import '../scripts/nav.js';
      import '../scripts/motion.js';
    </script>
  </body>
</html>
