---
// Header: wordmark, five section links and one call to action. Section links
// are absolute (/#how) so they also work from the blog.
interface Props { cta: string }
const { cta } = Astro.props;
const links = [
  { label: 'How it works', href: '/#how' },
  { label: 'Where it runs', href: '/#access' },
  { label: 'Results', href: '/#results' },
  { label: 'Partners', href: '/#partners' },
  { label: 'Blog', href: '/blog/' },
];
---
<header class="nav" id="nav">
  <a class="brand" href="/" aria-label="SiteSeer Building Information, home">
    <svg width="28" height="28" viewBox="0 0 34 34" aria-hidden="true">
      <rect width="34" height="34" rx="9" fill="#e6332a" />
      <path d="M8 16.5 L17 9 L26 16.5" stroke="#fff" stroke-width="2.4" fill="none" stroke-linejoin="round" stroke-linecap="round" />
      <line x1="10.5" y1="21.2" x2="23.5" y2="21.2" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
      <line x1="10.5" y1="25.6" x2="23.5" y2="25.6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
    </svg>
    SITESEER
  </a>
  <button class="menu" type="button" aria-expanded="false" aria-controls="navmenu">Menu</button>
  <nav aria-label="Main">
    <ul class="navlinks" id="navmenu">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
  <a class="nav-cta" href="/#contact">{cta}</a>
</header>
