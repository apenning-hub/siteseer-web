---
import { OTHER } from '../lib/audience';

interface Props { draft?: boolean }
const { draft = false } = Astro.props;
---
<footer class="site-foot">
  <div class="wrap">
    <img class="foot-logo" src="/logo.svg" alt="SiteSeer Building Information" width="300" height="48" loading="lazy" />
    <span>
      © 2026 SiteSeer Building Information. Built by Sean Pickersgill, Damian Madigan, Darcy Holmes and Andrew Lymn-Penning.
    </span>
    <nav aria-label="Footer">
      <a href="/blog/">Blog</a>
      <a href={OTHER.href}>{OTHER.label} →</a>
    </nav>
    {draft && <span class="draft">Draft copy, under review</span>}
  </div>
</footer>
