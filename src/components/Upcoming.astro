---
import Stop from './Stop.astro';
interface Props {
  upcoming: { heading: string; intro: string; groups: { title: string; items: { title: string; text: string }[] }[] };
  alt?: boolean;
}
const { upcoming, alt = false } = Astro.props;
---
<section class:list={['band', { alt }]} id="roadmap" aria-labelledby="roadmap-h">
  <div class="wrap">
    <div class="upcoming rv">
      <div class="head">
        <h2 id="roadmap-h"><Stop text={upcoming.heading} /></h2>
        <p class="intro">{upcoming.intro}</p>
      </div>
      <div class="groups">
        {upcoming.groups.map((g) => (
          <details class="ugroup" open>
            <summary><h3>{g.title}</h3></summary>
            <ul>{g.items.map((i) => <li><b>{i.title}</b><span>{i.text}</span></li>)}</ul>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // On phones the feature groups start folded, so the list isn't two screens long.
  if (matchMedia('(max-width: 800px)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('.ugroup').forEach((d) => { d.open = false; });
  }
</script>
