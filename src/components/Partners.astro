---
import { getCollection } from 'astro:content';

interface Props { partners: { eyebrow: string; heading: string; order: string[] }; alt?: boolean }
const { partners, alt = false } = Astro.props;
const all = await getCollection('partners');
const shown = partners.order.map((id) => {
  const p = all.find((x) => x.id === id);
  if (!p) throw new Error(`Partner "${id}" is in the site's partner order but not in src/content/partners.json`);
  return p.data;
});
// Groups keep the site's order within them; the group that leads is the one
// holding the site's first-listed partner.
const PARTNER_GROUPS = ['Partner', 'Supported by'] as const;
const groups = [...PARTNER_GROUPS]
  .map((g) => ({ g, items: shown.filter((p) => p.group === g) }))
  .filter(({ items }) => items.length)
  .sort((a, b) => shown.indexOf(a.items[0]) - shown.indexOf(b.items[0]));
const LABEL = { Partner: 'Partners', 'Supported by': 'Supported by' } as const;
---
<section class:list={['band', { alt }]} id="partners" aria-labelledby="partners-h">
  <div class="wrap">
    <p class="eyebrow rv">{partners.eyebrow}</p>
    <h2 class="h2 rv" id="partners-h">{partners.heading}</h2>
    {groups.map(({ g, items }) => (
      <div class="pgroup">
        <h3>{LABEL[g]}</h3>
        <div class="plist">
          {items.map((p) => (
            <article class="partner rv">
              <div class="logo"><img src={`/logos/${p.logo}`} alt="" loading="lazy" /></div>
              <div class="role">{p.role}</div>
              <h4>{p.name}</h4>
              <p>{p.blurb}</p>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
