---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

// ── SWAP IMAGES HERE ── drop files in /public/images and point a slot at them.
// landscape = window/desktop shots · portrait = phone screenshots
// b = base path so images resolve correctly on GitHub Pages (subpath) and in prod.
const b = import.meta.env.BASE_URL;
// NOTE (a11y, spec §5): six of the eight slots below point at product-hero.png.
// The three "first look" phones and the two "every device" phones are the same
// screenshot repeated, so their alt text cannot be accurate until real distinct
// images exist. Do not invent descriptions — replace the images.
const img = {
  heroProduct: `${b}images/product-hero.png`,   // hero desktop window (LANDSCAPE)
  everyPhoneL: `${b}images/product-hero.png`,    // every-device left phone (PORTRAIT)
  everyWindow: `${b}images/product-hero.png`,    // every-device centre window (LANDSCAPE)
  everyPhoneR: `${b}images/product-hero.png`,    // every-device right phone (PORTRAIT)
  groundUp:    `${b}images/product-process.jpg`, // built-from-ground-up framed (LANDSCAPE)
  lookPhone1:  `${b}images/product-hero.png`,    // first-look phone 1 (PORTRAIT)
  lookPhone2:  `${b}images/product-hero.png`,    // first-look phone 2 (PORTRAIT)
  lookPhone3:  `${b}images/product-hero.png`,    // first-look phone 3 (PORTRAIT)
};

// ── COPY LIVES IN src/content/home/*.json ── so a non-technical author can edit
// it through the CMS. Nothing below should ever be re-inlined here: the JSON is
// the single source of truth and the Zod schemas in src/content.config.ts guard
// its shape. See src/content/home/README.md.
//
// getCollection() makes no ordering promise, and every one of these is an
// ordered list, so sort by the numeric id the file() parser assigned.
const byIndex = (a: { id: string }, b: { id: string }) => Number(a.id) - Number(b.id);

const hero = (await getEntry('hero', 'hero'))!.data;
const pillars = (await getCollection('pillars')).sort(byIndex).map((e) => e.data);
const capabilities = (await getCollection('capabilities')).sort(byIndex).map((e) => e.data);
const outcomes = (await getCollection('outcomes')).sort(byIndex).map((e) => e.data);
const stats = (await getCollection('stats')).sort(byIndex).map((e) => e.data);
const roadmap = (await getEntry('roadmap', 'roadmap'))!.data;
const roadmapA = roadmap.rowA;
const roadmapB = roadmap.rowB;

/**
 * hero.lead is the only content field carrying markup: inline `**bold**`, so the
 * author gets a Bold button in the CMS instead of typing a tag. It must be
 * *converted*, not interpolated, or the asterisks print in the largest sentence
 * on the page.
 *
 * Escape first. This string is written by a CMS, so it is untrusted input being
 * handed to set:html — escaping before converting means the only tag that can
 * ever reach the page is the <b> this function produces.
 *
 * Inline bold is the entire grammar the README permits; a markdown library would
 * be several hundred kilobytes to do this one replace.
 */
const inlineBold = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
---
<Base>
  <!-- HERO -->
  <section class="band band-red grain hero tc">
    <div class="wrap" style="position:relative;z-index:2;max-width:920px;">
      <span class="kick reveal d1"><span class="ln"></span>{hero.kick}<span class="ln"></span></span>
      <h1 class="h1 druk">{hero.headline.map((line, i) => <span class={`reveal d${i + 2}`}>{line}</span>)}</h1>
      <p class="lead reveal d4" set:html={inlineBold(hero.lead)}></p>
      <div class="reveal d5" style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a class="btn btn-onred btn-lg" href="#contact">Start a pilot →</a>
        <a class="btn btn-ghostred btn-lg" href="#contact">Join the waitlist</a>
      </div>
      <div class="proof reveal d6">{hero.proof}</div>
    </div>
    <div class="wrap reveal d6" style="position:relative;z-index:2;max-width:980px;margin:50px auto -84px;">
      <div class="window">
        <div class="win-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="win-pill">siteseer — structural steel · ground floor</span></div>
        <img class="win-shot" src={img.heroProduct} alt="A SiteSeer construction environment on desktop, showing a partially framed building with its structure exposed" />
      </div>
    </div>
    <div style="height:84px;"></div>
  </section>

  <!-- EXPERTISE -->
  <section class="band" id="expertise">
    <div class="wrap">
      <div class="eyebrow">What we do</div>
      <h2 class="sh druk" style="max-width:14ch">Experts in construction digital learning<span class="dot">.</span></h2>
      <div class="pillars">
        {pillars.map((p) => (
          <div class="glass-light glass pill"><div class="no">{p.no}</div><h3>{p.h}</h3><p>{p.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROVEN -->
  <section class="band band-ink" id="proven">
    <div class="wrap">
      <div class="eyebrow">Proven. Better.</div>
      <div class="split">
        <div>
          <h2 class="sh druk">A decade of real<br />classroom results<span class="dot">.</span></h2>
          <p class="stext">When it's impossible to get students onto a construction site to connect theory to practice, SiteSeer is the solution — safe, repeatable, and on the devices they already carry.</p>
        </div>
        <div class="statstrip">
          {stats.map((s) => (
            <div class="statc glass"><div class="num">{s.num}</div><div class="cap">{s.cap}</div></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- EVERY DEVICE -->
  <section class="band tc" id="platform">
    <div class="wrap narrow">
      <div class="eyebrow">Everything, everywhere</div>
      <h2 class="sh druk">On every device<span class="dot">.</span></h2>
      <p class="stext">Stream the whole build on a personal laptop — no headset, no lab, no booking a site visit. The same environment, on every device.</p>
      <div class="chips"><div class="chip">✔ Windows</div><div class="chip">✔ macOS</div><div class="chip soon">iOS <span class="tag">SOON</span></div><div class="chip soon">Android <span class="tag">SOON</span></div></div>
    </div>
    <div class="wrap">
      <div class="devices">
        <div class="phone"><div class="scr"><img src={img.everyPhoneL} alt="SiteSeer running on a phone" /></div></div>
        <div class="window"><div class="win-bar"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i><span class="win-pill">siteseer — desktop</span></div><img class="win-shot" src={img.everyWindow} style="height:330px" alt="SiteSeer running on a desktop" /></div>
        <div class="phone"><div class="scr"><img src={img.everyPhoneR} alt="SiteSeer running on a phone" /></div></div>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="band band-red grain tc" id="capabilities">
    <div class="wrap">
      <div class="eyebrow">Why institutions choose SiteSeer</div>
      <h2 class="sh druk">Where gaming, education &amp; construction meet<span class="dot">.</span></h2>
      <div class="fgrid" style="margin-top:38px;">
        {capabilities.map((c) => (
          <div class="glass fitem"><div class="ic" aria-hidden="true">{c.ic}</div><h3>{c.h}</h3><p>{c.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- BUILT FROM THE GROUND UP -->
  <section class="band">
    <div class="wrap">
      <div class="split">
        <div>
          <div class="eyebrow">Built from the ground up</div>
          <h2 class="sh druk">Meticulously accurate<span class="dot">.</span></h2>
          <p class="stext">Purpose-built for students of all ages and experience levels, on construction-grade models — better than a real visit, because the information is accessible at <b>any</b> stage of the build.</p>
          <div class="fgrid" style="grid-template-columns:1fr 1fr;margin-top:30px;">
            <div class="glass-light glass fitem"><div class="ic" aria-hidden="true">◳</div><h3>Construction-grade</h3><p>Modelled to real detail, every trade.</p></div>
            <div class="glass-light glass fitem"><div class="ic" aria-hidden="true">⇆</div><h3>Tailorable depth</h3><p>Tune the experience to the cohort.</p></div>
          </div>
        </div>
        <div class="framed"><img src={img.groundUp} alt="A residential build shown at successive construction stages, from footings through frame to lock-up" /></div>
      </div>
    </div>
  </section>

  <!-- OUTCOMES -->
  <section class="band band-red grain tc" id="outcomes">
    <div class="wrap narrow">
      <div class="eyebrow">Job-ready graduates, built here</div>
      <h2 class="sh druk">Your future in construction starts here<span class="dot">.</span></h2>
      <div class="fgrid">
        {outcomes.map((o) => (
          <div class="glass fitem"><div class="ic" aria-hidden="true">{o.ic}</div><h3>{o.h}</h3><p>{o.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- FIRST LOOK -->
  <section class="band band-ink tc" id="demo">
    <div class="wrap narrow"><div class="eyebrow" style="color:var(--red);opacity:1">Your first look</div><h2 class="sh druk">See it for yourself<span class="dot">.</span></h2><p class="stext">Explore a demo and start imagining how SiteSeer fits your program.</p></div>
    <div class="wrap"><div class="phonerow">
      <div class="phone reveal d2"><div class="scr"><img src={img.lookPhone1} alt="SiteSeer running on a phone" /></div></div>
      <div class="phone reveal d3"><div class="scr"><img src={img.lookPhone2} alt="SiteSeer running on a phone" /></div></div>
      <div class="phone reveal d4"><div class="scr"><img src={img.lookPhone3} alt="SiteSeer running on a phone" /></div></div>
    </div></div>
    <div class="wrap narrow"><div style="display:flex;gap:12px;justify-content:center;margin-top:44px;flex-wrap:wrap;"><a class="btn btn-red btn-lg" href="#contact">Start a pilot →</a><a class="btn btn-onred btn-lg" href="#contact">Join the waitlist</a></div></div>
  </section>

  <!-- ROADMAP -->
  <section class="band tc" id="roadmap">
    <div class="wrap"><div class="eyebrow">On the roadmap</div><h2 class="sh druk">Upcoming features<span class="dot">.</span></h2></div>
    <div class="marquee">
      <div class="mrow">{[...roadmapA, ...roadmapA].map((f) => <span>{f}</span>)}</div>
      <div class="mrow rev">{[...roadmapB, ...roadmapB].map((f) => <span>{f}</span>)}</div>
    </div>
    <button class="marquee-toggle" type="button" aria-pressed="false" data-marquee-toggle>
      Pause scrolling
    </button>
  </section>
</Base>
