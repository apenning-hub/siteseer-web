---
// One homepage, two audiences. SITE_AUDIENCE picks the copy file; the
// sections are shared. Grounds alternate paper / soft grey after the hero.
import Base from '../layouts/Base.astro';
import Hero3D from '../components/Hero3D.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import UseCases from '../components/UseCases.astro';
import WhereItRuns from '../components/WhereItRuns.astro';
import Results from '../components/Results.astro';
import Partners from '../components/Partners.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import Upcoming from '../components/Upcoming.astro';
import { getEntry } from 'astro:content';
import { AUDIENCE } from '../lib/audience';

const entry = await getEntry('sites', AUDIENCE);
if (!entry) throw new Error(`No site copy for "${AUDIENCE}": check src/content/sites/${AUDIENCE}.json`);
const site = entry.data;

// Grounds alternate paper / soft grey down the page; `uses` only exists on the
// industry site, so the alternation is counted as the sections render.
let n = 0;
const alt = () => n++ % 2 === 0;
---
<Base>
  <Hero3D hero={site.hero} />
  <Problem problem={site.problem} alt={alt()} />
  <HowItWorks how={site.how} alt={alt()} />
  {site.uses && <UseCases uses={site.uses} alt={alt()} />}
  <WhereItRuns access={site.access} alt={alt()} />
  <Results results={site.results} alt={alt()} />
  {site.team && <Team team={site.team} alt={alt()} />}
  <Partners partners={site.partners} alt={alt()} />
  <Contact contact={site.contact} alt={alt()} />
  <Upcoming upcoming={site.upcoming} alt={alt()} />
</Base>
