---
// One homepage, two audiences. SITE_AUDIENCE picks the copy file; the
// sections are shared. Grounds alternate paper / soft grey after the hero.
import Base from '../layouts/Base.astro';
import Hero3D from '../components/Hero3D.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import UseCases from '../components/UseCases.astro';
import WhereItRuns from '../components/WhereItRuns.astro';
import Results from '../components/Results.astro';
import Partners from '../components/Partners.astro';
import Contact from '../components/Contact.astro';
import Upcoming from '../components/Upcoming.astro';
import { getEntry } from 'astro:content';
import { AUDIENCE } from '../lib/audience';

const entry = await getEntry('sites', AUDIENCE);
if (!entry) throw new Error(`No site copy for "${AUDIENCE}": check src/content/sites/${AUDIENCE}.json`);
const site = entry.data;

// Sections in page order; `uses` only exists on the industry site.
const sections = [
  [Problem, { problem: site.problem }],
  [HowItWorks, { how: site.how }],
  ...(site.uses ? [[UseCases, { uses: site.uses }]] : []),
  [WhereItRuns, { access: site.access }],
  [Results, { results: site.results }],
  [Partners, { partners: site.partners }],
  [Contact, { contact: site.contact }],
  [Upcoming, { upcoming: site.upcoming }],
] as const;
---
<Base>
  <Hero3D hero={site.hero} />
  {sections.map(([Section, props], i) => <Section {...props} alt={i % 2 === 0} />)}
</Base>
