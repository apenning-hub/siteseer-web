---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { AUDIENCE } from '../../lib/audience';
import { postsFor } from '../../lib/posts-core.mjs';

const posts = postsFor(await getCollection('blog'), AUDIENCE, { prod: import.meta.env.PROD });
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { year: 'numeric', month: 'short', day: 'numeric' });

const HEAD = {
  education: {
    heading: 'Construction education, in focus.',
    lede: 'Research-led, plain-English writing on the skills shortage, digital learning, and the tertiary, TAFE and school landscape.',
  },
  industry: {
    heading: 'Building, in focus.',
    lede: 'Writing on how buildings are documented, sequenced, questioned and fixed.',
  },
}[AUDIENCE];
---
<Base title="Blog: SiteSeer" description={HEAD.lede}>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">The SiteSeer blog</p>
      <h1 class="h2">{HEAD.heading}</h1>
      <p class="lede">{HEAD.lede}</p>
      {posts.length ? (
        <div class="bloglist">
          {posts.map((post) => (
            <a class="postcard" href={`/blog/${post.id}/`}>
              <div class="pc-tags">{post.data.tags.slice(0, 2).map((t) => <span class="tagpill">{t}</span>)}</div>
              <h2>{post.data.title}</h2>
              <p class="pc-desc">{post.data.description}</p>
              <div class="pc-meta">{fmt(post.data.pubDate)} · {post.data.author}</div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">New posts are on the way.</p>
      )}
    </div>
  </section>
</Base>
