---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  // Drafts still render in `npm run dev` so the author can preview them, but
  // are never built into a production deploy. Without this filter a draft is
  // hidden from the blog index while remaining live at a guessable URL.
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
const base = import.meta.env.BASE_URL;
---
<Base title={`${post.data.title} — SiteSeer`} description={post.data.description}>
  <article class="post">
    <a class="back-link" href={`${base}blog`}>← All posts</a>
    <div class="post-meta">
      <span>{fmt(post.data.pubDate)}</span><span>·</span><span>{post.data.author}</span>
      {post.data.tags.map((t) => <span class="tagpill">{t}</span>)}
    </div>
    <h1>{post.data.title}</h1>
    <p class="lede">{post.data.description}</p>
    <div class="prose"><Content /></div>
  </article>
</Base>
