---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Contact from '../../components/Contact.astro';
import { Picture } from 'astro:assets';
import { getCollection, getEntry, render as renderPost } from 'astro:content';
import { AUDIENCE } from '../../lib/audience';
import { postsFor } from '../../lib/posts-core.mjs';
import { render } from '../../lib/renders';
import { authorFor, readingMinutes } from '../../lib/authors';

export async function getStaticPaths() {
  // Only this site's posts get pages. Drafts still render in `npm run dev` so
  // the author can preview them, but are never built into a production deploy:
  // without that, a draft is hidden from the blog index while remaining live
  // at a guessable URL.
  const posts = postsFor(await getCollection('blog'), AUDIENCE, { prod: import.meta.env.PROD });
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id).slice(0, 2) } }));
}

const { post, others } = Astro.props;
const { Content } = await renderPost(post);
const d = post.data;
const author = authorFor(d.author);
const site = (await getEntry('sites', AUDIENCE))!.data;
const fmt = (date: Date) => date.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`${d.title}: SiteSeer`} description={d.description}>
  <article class="post page-top">
    <div class="post-head">
      <a class="back-link" href="/blog/">← All posts</a>
      <div class="post-meta">
        {d.tags[0] && <span class="pc-cat">{d.tags[0]}</span>}
        <span>{fmt(d.pubDate)}</span><span aria-hidden="true">·</span><span>{readingMinutes(post.body)} min read</span>
      </div>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <p class="byline">By <b>{author.name}</b>, {author.role}</p>
    </div>
    {d.image && (
      <figure class="post-figure">
        <Picture src={render(d.image)} alt={d.imageAlt ?? ''} widths={[640, 1000, 1400]} sizes="(min-width: 1100px) 1000px, 100vw" formats={['avif', 'webp']} loading="eager" />
      </figure>
    )}
    <div class="prose"><Content /></div>
    <aside class="author-card" aria-label="About the author">
      <span class="pc-cat">Written by</span>
      <b>{author.name}</b>
      <span>{author.role}</span>
    </aside>
  </article>
  {others.length > 0 && (
    <section class="band alt" aria-labelledby="more-h">
      <div class="wrap">
        <h2 class="more-h" id="more-h">More from the blog</h2>
        <div class="bloglist two-up">{others.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
  <Contact contact={site.contact} />
</Base>
