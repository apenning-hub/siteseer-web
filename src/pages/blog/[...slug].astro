---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { AUDIENCE } from '../../lib/audience';
import { postsFor } from '../../lib/posts-core.mjs';

export async function getStaticPaths() {
  // Only this site's posts get pages. Drafts still render in `npm run dev` so
  // the author can preview them, but are never built into a production deploy:
  // without that, a draft is hidden from the blog index while remaining live
  // at a guessable URL.
  const posts = postsFor(await getCollection('blog'), AUDIENCE, { prod: import.meta.env.PROD });
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`${post.data.title}: SiteSeer`} description={post.data.description}>
  <div class="wrap">
    <article class="post">
      <a class="back-link" href="/blog/">← All posts</a>
      <div class="post-meta">
        <span>{fmt(post.data.pubDate)}</span><span aria-hidden="true">·</span><span>{post.data.author}</span>
        {post.data.tags.map((t) => <span class="tagpill">{t}</span>)}
      </div>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="prose"><Content /></div>
    </article>
  </div>
</Base>
